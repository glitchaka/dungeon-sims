file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/terrain-blocks-v3/manifest.json" blockCatalog)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/assets/terrain-blocks-v3/manifest.json")
string(JSON blockCount LENGTH "${blockCatalog}" blocks)
set(blockHeader "#pragma once\n#include <array>\nnamespace isla::blockdata {\nstruct Definition {const char* id;const char* category;int mask;float height,relief;int count;std::array<std::array<int,2>,12> cells;};\ninline constexpr std::array<Definition,${blockCount}> definitions{{\n")
math(EXPR blockLast "${blockCount}-1")
foreach(i RANGE ${blockLast})
    foreach(field id category height)
        string(JSON ${field} GET "${blockCatalog}" blocks ${i} ${field})
    endforeach()
    string(JSON mask ERROR_VARIABLE maskError GET "${blockCatalog}" blocks ${i} cornerMask)
    if(maskError)
        set(mask -1)
    endif()
    string(JSON relief ERROR_VARIABLE reliefError GET "${blockCatalog}" blocks ${i} relief)
    if(reliefError)
        set(relief 0)
    endif()
    string(JSON count LENGTH "${blockCatalog}" blocks ${i} footprint)
    if(count GREATER 12 OR count LESS 1)
        message(FATAL_ERROR "Invalid terrain module footprint")
    endif()
    math(EXPR last "${count}-1")
    set(cells "")
    foreach(j RANGE ${last})
        string(JSON x GET "${blockCatalog}" blocks ${i} footprint ${j} 0)
        string(JSON y GET "${blockCatalog}" blocks ${i} footprint ${j} 1)
        string(APPEND cells "{{${x},${y}}},")
    endforeach()
    string(APPEND blockHeader "{\"${id}\",\"${category}\",${mask},${height},${relief},${count},{{${cells}}}},\n")
endforeach()
string(APPEND blockHeader "}};\n}\n")
file(MAKE_DIRECTORY "${CNC_GENERATED}")
file(CONFIGURE OUTPUT "${CNC_GENERATED}/TerrainBlockData.h" CONTENT "${blockHeader}" @ONLY)
