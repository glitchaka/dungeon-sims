"+":"00000/00100/00100/11111/00100/00100/00000", "%":"11001/11010/00100/00100/01000/10110/00110",
"?":"01110/10001/00001/00010/00100/00000/00100", "!":"00100/00100/00100/00100/00100/00000/00100",
