}
static func fill(canvas:Node2D,rect:Rect2,color:Color)->void:
	canvas.draw_texture_rect_region(SHEET,rect,INK,color)
static func text(canvas:Node2D,at:Vector2,value:String,scale_px:int=2,color:Color=Color("fff1e8"))->void:
	var clean:=value.to_upper().replace("Á","A").replace("É","E").replace("Í","I").replace("Ó","O").replace("Ú","U").replace("Ñ","N")
	var x:=at.x
	for character in clean:
		if GLYPHS.has(character):
			var rows:PackedStringArray=GLYPHS[character].split("/")
			for y in 7:
				for col in 5:
					if rows[y][col]=="1": fill(canvas,Rect2(x+col*scale_px,at.y+y*scale_px,scale_px,scale_px),color)
		x+=6*scale_px